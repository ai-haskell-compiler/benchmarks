{
  "schema_version": 2,
  "suite_id": "aihc-core-v2",
  "aihc_ref": "origin/main",
  "aihc_compiler_marker": "bin/aihc/aihc.cabal",
  "optimization_note": "GHC uses -O2 and -O0. AIHC O2 uses the compiler's default optimizing pipeline; AIHC O0 requires a commit whose build-exe advertises an optimization flag and is unavailable otherwise.",
  "reference": {
    "platform": "aarch64-darwin",
    "compiler": "aihc",
    "minimum_seconds": 0.1,
    "maximum_seconds": 1.0
  },
  "measurement": {
    "relative_threshold": 0.01,
    "maximum_bucket_size": 64,
    "process_timeout_seconds": 20,
    "compile_timeout_seconds": 900
  },
  "platforms": {
    "aarch64-darwin": {
      "aihc_native_target": "apple-arm64"
    },
    "x86_64-linux": {
      "aihc_native_target": "linux-amd64"
    }
  },
  "benchmarks": [
    {
      "id": "integer-factorial-v1",
      "source": "benchmarks/integer-factorial/Main.hs",
      "expected_stdout": "ok\n"
    },
    {
      "id": "integer-fibonacci-v1",
      "source": "benchmarks/integer-fibonacci/Main.hs",
      "expected_stdout": "ok\n"
    }
  ],
  "configurations": [
    {
      "id": "aihc-native-semispace-O2",
      "compiler_family": "aihc",
      "compiler_version": "commit",
      "compiler_variant": "default",
      "backend": "native",
      "gc": "semispace",
      "optimization": "O2",
      "aihc_target": "{aihc_native_target}",
      "artifact_suffix": "",
      "runtime_stats": "aihc",
      "requires": [],
      "compile": [
        "nix",
        "run",
        "{worktree}#aihc",
        "--",
        "{aihc_build_command}",
        "{source}",
        "--output",
        "{artifact}",
        "--target",
        "{aihc_native_target}",
        "--gc",
        "semispace"
      ],
      "run": [
        "{artifact}"
      ]
    },
    {
