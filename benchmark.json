        "nix",
        "run",
        "{worktree}#aihc",
        "--",
        "{aihc_build_command}",
        "{source}",
        "--output",
        "{artifact}",
        "--target",
        "wasm32-wasip3",
        "--gc",
        "semispace"
      ],
      "run": [
        "wasmtime",
        "run",
        "-C",
        "cache=n",
        "-S",
        "cli",
        "--dir",
        "{stats_dir}",
        "--env",
        "AIHC_RTS_STATS={stats_file}",
