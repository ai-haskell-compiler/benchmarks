cabal-version: 3.8
name: aihc-resolve-bench
version: 0.1.0.0
synopsis: AIHC benchmark: name resolution across generated modules
license: Unlicense
build-type: Simple

executable aihc-resolve-bench
  main-is: Main.hs
  other-modules: ModuleGraph
  build-depends: base, containers, deepseq, text, aihc-parser ==5.0.0.0, aihc-resolve ==0.1.0.0
  default-language: Haskell2010
  ghc-options: -Wall

test-suite graph-tests
  type: exitcode-stdio-1.0
  main-is: GraphTests.hs
  hs-source-dirs: test, .
  other-modules: ModuleGraph
  build-depends: base, containers
  default-language: Haskell2010
  ghc-options: -Wall
